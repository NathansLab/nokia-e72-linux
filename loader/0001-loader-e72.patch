+#ifdef RB_E72
+#include "tramp_scatter.hdr" // KTrampScatter[], KTrampScatterLen
+typedef void (*TScatterFn)(TUint32 aList, TUint32 aPages, TUint32 aTarget, TUint32 aDtbOff);
+
+// scatter boot (E72). slot i = 4 kb at KE72Target+i*4k. a slot is backed
+// lazily on first load: a page symbian hands out INSIDE the target becomes the
+// slot it already sits in (no copy needed, "fixed"); a page outside the target
+// backs the slot being loaded and is copied there by tramp_scatter with the
+// mmu off. a target page whose slot is already backed is held until the boot
+// (nothing of symbian's may land there). no contiguous ram needed at all
+TPhysAddr DE5BootChan::GetSlot(TUint32 aSlot){
+	if(aSlot>=iNPages){return 0;}
+	if(iList[aSlot]){return iList[aSlot];}
+	const TUint32 lo=KE72Target, hi=KE72Target+iNPages*0x1000u;
+	for(;;){
+		TPhysAddr p=0;
+		if(Epoc::AllocPhysicalRam(0x1000, p, 0)!=KErrNone){return 0;}
+		if(p>=lo && p<hi){
+			TUint32 s=(p-lo)>>12;
+			if(!iList[s]){
+				iList[s]=p; ++iGot; ++iFixed;
+				if(s==aSlot){return p;}
+				continue;
+			}
+			if(iNHeld<iNPages){iHeld[iNHeld++]=p; continue;}
+			Epoc::FreePhysicalRam(p, 0x1000);
+			return 0;
+		}
+		iList[aSlot]=p; ++iGot;
+		return p;
+	}
+}
+
+// contiguous block outside the target; whatever lands inside is held and
+// given back afterwards (symbian hands out low addresses first = the target)
+TPhysAddr DE5BootChan::AllocOutside(TUint32 aBytes, TInt aAlign){
+	const TUint32 lo=KE72Target, hi=KE72Target+KE72MaxPages*0x1000u;
+	const TInt KMaxHold=512;
+	TPhysAddr* held=(TPhysAddr*)Kern::Alloc(KMaxHold*sizeof(TPhysAddr));
+	if(!held){return 0;}
+	TInt nh=0;
+	TPhysAddr got=0;
+	while(nh<KMaxHold){
+		TPhysAddr p=0;
+		if(Epoc::AllocPhysicalRam((TInt)aBytes, p, aAlign)!=KErrNone){break;}
+		if(p+aBytes<=lo || p>=hi){got=p; break;}
+		held[nh++]=p;
+	}
+	for(TInt i=0; i<nh; ++i){Epoc::FreePhysicalRam(held[i], (TInt)aBytes);}
+	Kern::Free(held);
+	return got;
+}
+
+// AllocBoot: only the list. on failure a2 gets a code: 0xE7100000 = no list
+TInt DE5BootChan::AllocScatter(TUint32 aSize, TAny* a2){
+	ReleaseBoot();
+	TUint32 n=(aSize+0xfffu)>>12;
+	if(n==0 || n>KE72MaxPages){return KErrArgument;}
+	TUint32 out=0xE7100000u;
+	iListPhys=AllocOutside(KE72ListBytes, 12);
+	if(!iListPhys){Kern::ThreadRawWrite(&Kern::CurrentThread(), a2, &out, 4); return KErrNoMemory;}
+	TInt r=DPlatChunkHw::New(iListChunk, iListPhys, (TInt)KE72ListBytes, EMapAttrSupRw|EMapAttrFullyBlocking);
+	if(r!=KErrNone){iListChunk=NULL; ReleaseBoot(); return r;}
+	iList=(volatile TUint32*)iListChunk->LinearAddress();
+	for(TUint32 i=0; i<KE72MaxPages; ++i){iList[i]=0;}
+	iHeld=(TPhysAddr*)Kern::Alloc(n*sizeof(TPhysAddr));
+	if(!iHeld){ReleaseBoot(); return KErrNoMemory;}
+	iNPages=n; iNHeld=0; iGot=0; iFixed=0;
+	iBootPhys=KE72Target;
+	iBootSize=n*0x1000u;
+	out=(TUint32)KE72Target;
+	return Kern::ThreadRawWrite(&Kern::CurrentThread(), a2, &out, 4);
+}
+
+// copies user data into the slots, one short uncached mapping per page.
+// out of ram -> KErrNoMemory-1000-<slots backed so far>/16 so boot.log says how far it got
+TInt DE5BootChan::LoadScatter(TUint32 aOff, const TUint8* aSrc, TUint32 aLen){
+	if(!iList){return KErrNotReady;}
+	if(aOff>iBootSize || aLen>iBootSize-aOff){return KErrArgument;}
+	while(aLen){
+		TUint32 pg=aOff>>12, po=aOff&0xfffu, n=0x1000u-po;
+		if(n>aLen){n=aLen;}
+		TBool fresh=!iList[pg];
+		TPhysAddr p=GetSlot(pg);
+		if(!p){return -1000-(TInt)iGot;}
+		// the page may still have symbian's dirty lines in L1: flush them now,
+		// before our data goes in uncached (see tramp_scatter.S)
+		if(fresh){asm volatile("mcr p15,0,%0,c7,c14,0"::"r"(0)); Dsb();}
+		DPlatChunkHw* c=NULL;
+		TInt r=DPlatChunkHw::New(c, p, 0x1000, EMapAttrSupRw|EMapAttrFullyBlocking);
+		if(r!=KErrNone){return r;}
+		r=Kern::ThreadRawRead(&Kern::CurrentThread(), aSrc, (TUint8*)(c->LinearAddress()+po), (TInt)n);
+		c->Close(NULL);
+		if(r!=KErrNone){return r;}
+		aOff+=n; aSrc+=n; aLen-=n;
+	}
+	return KErrNone;
+}
+
+// tramp_scatter in its own page (outside the target), identity mapped, go
+TInt DE5BootChan::BootScatter(TUint32 aDtbOff){
