+	// without a reset): tells where a silent thread death happens
+	volatile TUint32* st=iIsahChunk ? ((volatile TUint32*)iIsahChunk->LinearAddress())+13 : NULL;
+#define RB_ST(n) do{if(st){st[0]=(n); Dsb();}}while(0)
+	RB_ST(0xb0070001u);
+	if(!iList){return KErrNotReady;}
+	TPhysAddr sp=AllocOutside(0x1000, 0);
+	if(!sp){return -2000;}
+	if(st){st[1]=sp;}
+	RB_ST(0xb0070002u);
+	DPlatChunkHw* sc=NULL;
+	if(DPlatChunkHw::New(sc, sp, 0x1000, EMapAttrSupRw|EMapAttrFullyBlocking)!=KErrNone){
+		Epoc::FreePhysicalRam(sp, 0x1000);
+		return -2001;
+	}
+	volatile TUint8* sb=(volatile TUint8*)sc->LinearAddress();
+	for(TUint i=0; i<KTrampScatterLen; ++i){sb[i]=KTrampScatter[i];}
+	*(volatile TUint32*)(sb+KTrampScatterLen-8)=iL2Base; // l2base word
+	*(volatile TUint32*)(sb+KTrampScatterLen-4)=RB_LOGPHYS+0xff000u; // trace words
+	RB_ST(0xb0070003u);
+	TUint32 idx=0, old=0;
+	DPlatChunkHw* cl=IdMapExec(sp, idx, old);
+	if(!cl){sc->Close(NULL); Epoc::FreePhysicalRam(sp, 0x1000); return -2002;}
+	if(st){st[2]=old;}
+	RB_ST(0xb0070004u);
+	Cache::IMB_Range((TLinAddr)sp, KTrampScatterLen);
+	RB_ST(0xb0070005u);
+	TUint32 first=*(volatile TUint32*)sp; // data read through the identity map
+	if(st){st[2]=first;}
+	RB_ST(0xb0070006u);
+
+	NKern::DisableAllInterrupts(); // no symbian code runs after this
+	RB_ST(0xb0070007u);
+	TScatterFn fn=(TScatterFn)sp;
+	fn((TUint32)iListPhys, iNPages, KE72Target, aDtbOff); // never returns
+	return KErrNone; // unreachable
+}
+#endif
+
 TInt DE5BootChan::Request(TInt aFunction, TAny* a1, TAny* a2){
+#ifdef RB_E72
+	if(aFunction==RRunBlob::EControlAllocBoot){
+		TUint32 req=0;
+		TInt rr=Kern::ThreadRawRead(&Kern::CurrentThread(), a1, &req, 4);
+		if(rr!=KErrNone){return rr;}
+		return AllocScatter(req, a2);
+	}
+	if(aFunction==RRunBlob::EControlLoadChunk){
+		TLoadChunk c;
+		TInt rr=Kern::ThreadRawRead(&Kern::CurrentThread(), a1, &c, sizeof(c));
+		if(rr!=KErrNone){return rr;}
+		return LoadScatter(c.iOffset, (const TUint8*)c.iSrc, c.iLen);
+	}
+	if(aFunction==RRunBlob::EControlBoot){
+		TBootParams b;
+		TInt rr=Kern::ThreadRawRead(&Kern::CurrentThread(), a1, &b, sizeof(b));
+		if(rr!=KErrNone){return rr;}
+		return BootScatter(b.iDtbOff);
+	}
+#endif
 	if(aFunction==RRunBlob::EControlAllocBoot){return AllocBoot(a1, a2);}
 
 	if(aFunction==RRunBlob::EControlReadPhys){return ReadPhys((TUint32)a1, a2);}
diff --git a/linux/stage0/symbian-loader/e72dump_app.cpp b/linux/stage0/symbian-loader/e72dump_app.cpp
new file mode 100644
index 0000000..47f46ed
--- /dev/null
+++ b/linux/stage0/symbian-loader/e72dump_app.cpp
@@ -0,0 +1,62 @@
+// Nokia E72: copies the whole RAM (128 mb from 0x10000000) to E:\e72ram.bin
+// with the ReadPhys control of e5boot_ldd.cpp (plain RAM reads, nothing
+// else), to analyse symbian + the modem software (ISASW, PA_SWD) offline.
+// progress in E:\e72dump.log. a block that cannot be read is written as zeros
+#include <e32std.h>
+#include <f32file.h>
+#include "runblob.h"
+
+_LIT(KLog, "E:\\e72dump.log");
+_LIT(KBin, "E:\\e72ram.bin");
+const TUint32 KPhys=0x10000000u;
+const TUint32 KLen=0x07ff0000u; // not the last 64 kb above the secure message pool (never mapped by symbian)
+const TUint32 KStep=0x8000u;
+
+static void L(RFs& fs, const TDesC8& m){
+	RFile f; TInt r=f.Open(fs, KLog, EFileWrite);
+	if(r==KErrNotFound){r=f.Create(fs, KLog, EFileWrite);}
+	if(r!=KErrNone){return;}
+	TInt p=0; f.Seek(ESeekEnd, p); f.Write(m); f.Flush(); f.Close();
+}
+
+GLDEF_C TInt E32Main(){
+	RFs fs;
+	if(fs.Connect()!=KErrNone){return KErrGeneral;}
+	TBuf8<96> b;
+	b.Copy(_L8("e72dump\n")); L(fs, b);
+	User::FreeLogicalDevice(KRunBlobName);
+	TInt rLoad=User::LoadLogicalDevice(KRunBlobLdd);
+	b.Format(_L8("Load=%d\n"), rLoad); L(fs, b);
+	if(rLoad==KErrNone || rLoad==KErrAlreadyExists){
+		RRunBlob dev;
+		if(dev.Open()==KErrNone){
+			RFile out;
+			TInt ro=out.Replace(fs, KBin, EFileWrite);
+			b.Format(_L8("Replace=%d\n"), ro); L(fs, b);
+			if(ro==KErrNone){
+				TUint8* mem=(TUint8*)User::Alloc(KStep);
+				if(mem){
+					TInt bad=0, werr=0;
+					for(TUint32 off=0; off<KLen; off+=KStep){
+						TPtr8 buf(mem, 0, KStep);
+						TInt r=dev.ReadPhys(KPhys+off, buf);
+						if(r!=KErrNone || buf.Length()!=(TInt)KStep){
+							if(bad<16){b.Format(_L8("ReadPhys@%x=%d\n"), KPhys+off, r); L(fs, b);}
+							bad++;
+							buf.SetLength(KStep); buf.FillZ();
+						}
+						TInt w=out.Write(buf);
+						if(w!=KErrNone){b.Format(_L8("Write@%x=%d\n"), off, w); L(fs, b); werr=w; break;}
+						if((off&0x7fffffu)==0){out.Flush(); b.Format(_L8("at %x bad=%d\n"), KPhys+off, bad); L(fs, b);}
+					}
+					b.Format(_L8("done bad=%d werr=%d\n"), bad, werr); L(fs, b);
+					User::Free(mem);
+				}
+				out.Flush(); out.Close();
+			}
+			dev.Close();
+		}
+	}
+	fs.RSessionBase::Close(); // RFs::Close is not exported by the 9.3 efsrv
+	return KErrNone;
+}
