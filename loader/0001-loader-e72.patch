diff --git a/linux/boot/tramp_scatter.S b/linux/boot/tramp_scatter.S
new file mode 100644
index 0000000..d925506
--- /dev/null
+++ b/linux/boot/tramp_scatter.S
@@ -0,0 +1,96 @@
+@ ONE-WAY scatter handoff (Nokia E72): like tramp_boot.S, but the kernel
+@ blob (Image at +0x8000, dtb at +dtboff) lies in single 4 kb pages anywhere in
+@ RAM. after the mmu is off this copies page i of the list to target+i*4k,
+@ then jumps into the kernel at target+0x8000 with r2 = target+dtboff.
+@ needed because a 128 mb E72 rarely has a free contiguous 16/32 mb block.
+@
+@ runs from an IDENTITY-mapped page (virt==phys). the booter guarantees that
+@ neither this page, the list nor any source page lies in [target, target+n*4k)
+@
+@ caller abi (booter driver, mmu on, svc):
+@ r0 = page list phys (n words, phys of each 4 kb source page)
+@ r1 = n (pages)
+@ r2 = target phys (2 mb aligned, kernel runs in place there)
+@ r3 = dtb offset in the blob
+@ registers only after the mmu goes off, no stack, no literal pool
+
+        .syntax unified
+        .arm
+        .section .text
+        .global tramp_scatter
+        .type tramp_scatter, %function
+tramp_scatter:
+        mov     r4, r0 @ list
+        mov     r5, r1 @ pages left
+        mov     r6, r2 @ target
+        mov     r7, r3 @ dtb offset
+
+        cpsid   if
+        ldr     r11, l2base @ L220 phys base, 0 = leave L2 alone
+
+        @ caches: "invalidate entire D cache" (c7,c6,0) is not allowed in the
+        @ non-secure world on this cpu (undefined -> symbian killed the thread,
+        @ v3). clean+invalidate (c7,c14,0) as tramp_boot.S does. the booter
+        @ cleans the D cache before it writes each page (uncached), so this
+        @ clean has no stale dirty line of ours left to push over a loaded page
+        mov     r2, #0
+        mcr     p15, 0, r2, c7, c14, 0 @ clean+invalidate D cache
+        mcr     p15, 0, r2, c7, c5, 0 @ invalidate I cache
+        mcr     p15, 0, r2, c7, c10, 4 @ DSB
+        mcr     p15, 0, r2, c7, c5, 4 @ ISB
+        mrc     p15, 0, r3, c1, c0, 0
+        bic     r3, r3, #0x5 @ mmu + D cache off
+        bic     r3, r3, #0x30000000 @ FA + TR off (see tramp_boot.S)
+        mcr     p15, 0, r3, c1, c0, 0 @ MMU OFF
+        mcr     p15, 0, r2, c7, c5, 4 @ ISB
+
+        ldr     r12, mark @ trace words in the ram log MB (survive the reset)
+        cmp     r12, #0
+        strne   r6, [r12] @ [0] = target: mmu is off
+
+        @ entry 0 = slot never loaded (gap/bss), entry == dst = page already
+        @ in place ("fixed"): both skipped, only outside pages get copied
+        mov     r8, r6 @ dst
+1:      cmp     r5, #0
+        beq     3f
+        sub     r5, r5, #1
+        ldr     r9, [r4], #4 @ src page
+        cmp     r9, #0
+        cmpne   r9, r8
+        addeq   r8, r8, #0x1000
+        beq     1b
+        add     r10, r9, #0x1000
+2:      ldmia   r9!, {r0, r1, r2, r3}
+        stmia   r8!, {r0, r1, r2, r3}
+        cmp     r9, r10
+        bne     2b
+        b       1b
+
+3:      cmp     r12, #0
+        strne   r8, [r12, #4] @ [1] = end of copy: all pages in place
+        @ the copy went past the L2 (D cache off = non-cacheable), so the L2
+        @ may hold symbian's old lines of the target. invalidate all ways; the
+        @ control register is left alone (secure-only write)
+        cmp     r11, #0
+        beq     4f
+        mov     r0, #0xff
+        str     r0, [r11, #0x77c] @ L220 invalidate by way, all ways
+5:      ldr     r0, [r11, #0x77c]
+        tst     r0, #0xff
+        bne     5b
+        mov     r0, #0
+        str     r0, [r11, #0x730] @ cache sync
+4:      cmp     r12, #0
+        strne   r11, [r12, #8] @ [2] = L2 base, written AFTER the invalidate
+        mov     r0, #0
+        mcr     p15, 0, r0, c7, c10, 4 @ DSB
+        mcr     p15, 0, r0, c7, c5, 0 @ invalidate I cache (new code)
+        mcr     p15, 0, r0, c7, c5, 4 @ ISB
+        mvn     r1, #0 @ machine type ~0 (dt)
+        add     r2, r6, r7 @ dtb phys
+        add     r4, r6, #0x8000 @ Image entry (TEXT_OFFSET low bits)
+        bx      r4
+        @ last two words, patched by the booter
+l2base: .word   0 @ KTrampScatterLen-8
+mark:   .word   0 @ KTrampScatterLen-4: trace address (RB_LOGPHYS+0xff000)
+        .size tramp_scatter, .-tramp_scatter
