@@ -561,12 +571,15 @@ GLDEF_C TInt E32Main(){
 	// E5 handoff block for the PA_SWD bridge (phase A: only saved, linux does
 	// not use it yet). failure is logged, the boot goes on
 	{
-		TBuf8<44> ib;
+		TBuf8<56> ib;
 		TInt ir=dev.SaveIsah(ib);
 		const TUint32* iw=(const TUint32*)ib.Ptr();
-		if(ir==KErrNone && ib.Length()==44){
+		if(ir==KErrNone && ib.Length()>=44){
 			Lf(_L8("isah=0 ttbr0=%08x ttbr1=%08x ttbcr=%08x\n"), iw[0], iw[1], iw[2]);
 			for(TInt i=0; i<8; ++i){Lf(_L8("isah l1[%d]=%08x\n"), i, iw[3+i]);}
+#ifdef RB_E72
+			if(ib.Length()>=56){Lf(_L8("l2 id=%08x ctrl=%08x aux=%08x\n"), iw[11], iw[12], iw[13]);}
+#endif
 		}else{
 			Lf(_L8("isah=%d len=%d\n"), ir, ib.Length());
 		}
@@ -580,6 +593,16 @@ GLDEF_C TInt E32Main(){
 #endif
 	L(_L8("about-to-Boot (one-way)\n"));
 	gLog.Close(); FSCLOSE();
-	dev.Boot(KZOff, KDtbOff, 0xFFFFFFFFu, 0); // never returns
+	TInt rb=dev.Boot(KZOff, KDtbOff, 0xFFFFFFFFu, 0); // returns only on error
+#ifdef RB_E72
+	// the handoff came back: say so instead of quitting silently
+	if(gFs.Connect()==KErrNone && gLog.Open(gFs, KLog, EFileWrite)==KErrNone){
+		TInt end=0; gLog.Seek(ESeekEnd, end);
+		Lf(_L8("Boot returned %d\n"), rb);
+		gLog.Close();
+	}
+	Fail(_L("handoff failed"), rb);
+#endif
+	(void)rb;
 	return KErrNone;
 }
