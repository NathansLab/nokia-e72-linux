From: Nathan Scheufele
Subject: [PATCH] timer-rapuyama-e5: optional one-shot mode (e6.oneshot=1), experimental

---
--- a/drivers/clocksource/timer-rapuyama-e5.c
+++ b/drivers/clocksource/timer-rapuyama-e5.c
@@ -44,6 +44,21 @@
 #define TICK_BASE_HZ	1000
 #define WDT_KICK_TICKS	100
 
+/*
+ * One-shot mode (e6.oneshot=1), probed on an E72: the counter is 32 bit wide
+ * and free running. It does not reload by itself, it wraps through zero to
+ * 0xffffffff and raises the irq there. A write to +0x24 sets the count, a
+ * write to +0x44 adds to it (which is how the 1 ms isr re-arms drift free).
+ * So an event is programmed by writing the delta to +0x24. The write takes
+ * effect at once, also when WFI follows directly (probed: 50 ms events wake
+ * the cpu on time).
+ * Open: with one-shot mode AND WFI idle the wl1251 stalls (it gets no more
+ * interrupts until WFI is switched off again), so this stays opt-in.
+ */
+#define TICK_RATE	7680000
+#define TICK_MIN_DELTA	768		/* 100 us */
+#define TICK_MAX_DELTA	(TICK_RATE / 2)	/* the isr also feeds the soc wdt */
+
 #ifdef CONFIG_ARCH_RAPUYAMA
 void rapuyama_early_wdt_kick(void);
 #else
@@ -54,7 +69,17 @@
 static void __iomem *fc_base;
 static u32 tick_accumulator;
 static u32 tick_wdt_ticks;
+static bool tick_oneshot;
+static bool tick_programmed;
+static u32 tick_wdt_fc;
+static u32 tick_wdt_fc_step = FC_DEF_RATE / 10;
 
+static int __init rapuyama_e5_oneshot_param(char *s)
+{
+	return kstrtobool(s, &tick_oneshot);
+}
+early_param("e6.oneshot", rapuyama_e5_oneshot_param);
+
 static u64 notrace rapuyama_e5_fc_read(void)
 {
 	writel_relaxed(FC_LATCH_VAL, fc_base + FC_LATCH);
@@ -84,6 +109,29 @@
 	writel_relaxed(TICK_RELOAD, tick_base + TICK_ACK);
 }
 
+static void rapuyama_e5_tick_set(u32 count)
+{
+	int n = TICK_SYNC_LOOPS;
+
+	while (readl_relaxed(tick_base + TICK_ACK) && --n)
+		cpu_relax();
+	writel_relaxed(count, tick_base + TICK_COUNT);
+}
+
+static int rapuyama_e5_set_next_event(unsigned long delta,
+				      struct clock_event_device *evt)
+{
+	tick_programmed = true;
+	rapuyama_e5_tick_set(delta);
+	return 0;
+}
+
+static int rapuyama_e5_set_oneshot(struct clock_event_device *evt)
+{
+	rapuyama_e5_tick_set(TICK_MAX_DELTA);
+	return 0;
+}
+
 static int rapuyama_e5_set_periodic(struct clock_event_device *evt)
 {
 	tick_accumulator = 0;
@@ -112,6 +160,22 @@
 {
 	struct clock_event_device *evt = dev_id;
 
+	if (clockevent_state_oneshot(evt)) {
+		u32 now = rapuyama_e5_fc_read();
+
+		if (now - tick_wdt_fc >= tick_wdt_fc_step) {
+			tick_wdt_fc = now;
+			rapuyama_early_wdt_kick();
+		}
+		tick_programmed = false;
+		if (evt->event_handler)
+			evt->event_handler(evt);
+		/* never leave the counter below zero, wake up for the wdt */
+		if (!tick_programmed)
+			rapuyama_e5_tick_set(TICK_MAX_DELTA);
+		return IRQ_HANDLED;
+	}
+
 	rapuyama_e5_tick_rearm();
 
 	/* feed the soc watchdog until the wdt driver is up */
@@ -186,7 +250,17 @@
 
 	rapuyama_e5_ced.irq = irq;
 	rapuyama_e5_ced.cpumask = cpu_possible_mask;
-	clockevents_register_device(&rapuyama_e5_ced);
+	tick_wdt_fc_step = fc_rate / 10;
+	if (tick_oneshot) {
+		rapuyama_e5_ced.features |= CLOCK_EVT_FEAT_ONESHOT;
+		rapuyama_e5_ced.set_next_event = rapuyama_e5_set_next_event;
+		rapuyama_e5_ced.set_state_oneshot = rapuyama_e5_set_oneshot;
+		clockevents_config_and_register(&rapuyama_e5_ced, TICK_RATE,
+						TICK_MIN_DELTA, TICK_MAX_DELTA);
+		pr_info("rapuyama-e5-timer: one-shot capable\n");
+	} else {
+		clockevents_register_device(&rapuyama_e5_ced);
+	}
 
 	pr_info("rapuyama-e5-timer: 1 kHz base / %u Hz Linux tick (irq %d), counter %lu Hz\n",
 		HZ, irq, fc_rate);
