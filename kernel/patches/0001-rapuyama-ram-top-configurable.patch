diff --git a/include/linux/rapuyama_mem.h b/include/linux/rapuyama_mem.h
new file mode 100644
index 0000000..1703849
--- /dev/null
+++ b/include/linux/rapuyama_mem.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * top of ram of the rapuyama phone this kernel is built for. the E5/E6
+ * have 256 MB (0x10000000..0x1fffffff), the E72 (RM-530) has 128 MB
+ * (0x10000000..0x17ffffff). every fixed address symbian/the booter keeps
+ * near the top of ram (ramcon log, isah handoff block, modem shm) is written
+ * as its E5/E6 value and moved with RY_TOP() (CONFIG_RAPUYAMA_RAM_TOP)
+ */
+#ifndef _LINUX_RAPUYAMA_MEM_H
+#define _LINUX_RAPUYAMA_MEM_H
+#ifdef CONFIG_RAPUYAMA_RAM_TOP
+#define RY_RAM_TOP	CONFIG_RAPUYAMA_RAM_TOP
+#else
+#define RY_RAM_TOP	0x20000000
+#endif
+#define RY_TOP(a)	((a) - 0x20000000 + RY_RAM_TOP)
+#endif
