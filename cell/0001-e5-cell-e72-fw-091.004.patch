From: Nathan Scheufele
Subject: [PATCH] e5-cell: build the modem runtime for the E72 (fw 091.004) from the same sources, untested on device

---
--- a/linux/e5-cell/build.sh
+++ b/linux/e5-cell/build.sh
@@ -23,6 +23,9 @@
 S="$HERE/sim"
 "${CC[@]}" -I "$S" -o "$OUT/e5rt" "$S/e5rt-sim.c" "$S/sim_runtime.c" "$S/os_timer_runtime.c" \
 	"$S/identity_runtime.c" "$S/kasumi_runtime.c"
+# E72 (RM-530) fw 091.004: same sources behind sim/fwsel.h, plus the measurement tap (off by default)
+"${CC[@]}" -I "$S" -DE72_FW091004 -pthread -o "$OUT/e72rt" "$S/e5rt-sim.c" "$S/sim_runtime.c" \
+	"$S/os_timer_runtime.c" "$S/identity_runtime.c" "$S/kasumi_runtime.c" "$S/meas_tap.c"
 if [ -n "${2:-}" ]; then
 	KB="$(cd "$2" && pwd)"
 	cp "$HERE/e5mem/e5mem.c" "$HERE/e5mem/Kbuild" "$OUT/"
